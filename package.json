{
  "name": "kando",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "db:migrate": "pnpm --filter @kando/db migrate",
    "db:generate": "pnpm --filter @kando/db generate",
    "db:import:postcodes": "pnpm --filter @kando/db import:postcodes",
    "db:seed": "pnpm --filter @kando/db seed",
    "db:seed:categories": "pnpm --filter @kando/db seed:categories",
    "db:seed:test-users": "pnpm --filter @kando/domain seed:test-users",
    "db:seed:placeholder-photos": "pnpm --filter @kando/domain seed:placeholder-photos"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@neon/config": "1.9.4",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
