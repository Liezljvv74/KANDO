{
  "name": "@kando/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate-cli.ts",
    "import:postcodes": "tsx --env-file-if-exists=../../.env src/import-postcodes-cli.ts",
    "seed": "pnpm seed:categories",
    "seed:categories": "tsx --env-file-if-exists=../../.env scripts/seed-categories.ts",
    "apply:required-documents": "tsx --env-file-if-exists=../../.env scripts/apply-required-documents.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
