# Pooled Neon connection string (app runtime)
DATABASE_URL=
# Direct Neon connection string (migrations)
DATABASE_URL_UNPOOLED=
# Docker test database
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5433/kando
# Neon branch in use: dev or main
NEON_BRANCH=
# Neon Auth base URL
NEON_AUTH_BASE_URL=
# Secret that signs the Neon Auth cookie
NEON_AUTH_COOKIE_SECRET=
# Public URL of the web app
NEXT_PUBLIC_SERVER_URL=
# Object storage access key id
AWS_ACCESS_KEY_ID=
# Object storage secret key
AWS_SECRET_ACCESS_KEY=
# Object storage region
AWS_REGION=
# Object storage endpoint
AWS_ENDPOINT=
# Public media bucket name
MEDIA_BUCKET=
# Private documents bucket name
DOCUMENTS_BUCKET=
# Resend API key for email
RESEND_API_KEY=
# OpenRouter API key (server only): the translate button and the AI document check
OPENROUTER_API_KEY=
# Model used for the AI check of uploaded documents (an OpenRouter model id that can read images and PDFs). The check is OFF until
# this AND OPENROUTER_API_KEY are both set, so the translate key alone never sends a document anywhere. Choose it after `pnpm ai:eval`.
AI_DOCUMENT_MODEL=
# Optional: pin the check to ONE OpenRouter provider, by its slug from the model page (for example google-vertex). Nothing is then sent to any other provider. A mistyped value switches the check off.
AI_DOCUMENT_PROVIDER=
# Confidence (0 to 1) the AI needs to approve a document by itself; below it a person decides. Default 0.8
AI_MIN_CONFIDENCE=
# Most the AI document checks may cost per calendar month, in euro; when it is reached documents go to staff. Default 20
AI_MONTHLY_CAP_EUR=
# Comma separated OpenRouter model ids that `pnpm ai:eval` compares (script only, on made-up documents)
AI_EVAL_MODELS=
# Model used for translation
TRANSLATE_MODEL=
# Translate requests allowed per user per hour
TRANSLATE_LIMIT_PER_HOUR=
# Translate request timeout in milliseconds
TRANSLATE_TIMEOUT_MS=
# Secret: Vercel sends it as a Bearer token to the daily suspension check (Production only)
CRON_SECRET=
# Set to true to switch card payments on
PAYMENTS_ENABLED=
# Stripe secret API key (server only)
STRIPE_SECRET_KEY=
# Signing secret of the Stripe account webhook
STRIPE_WEBHOOK_SECRET=
# Signing secret of the Stripe Connect webhook
STRIPE_CONNECT_WEBHOOK_SECRET=
# Optional: Vercel Deployment Protection bypass secret, only for pnpm payments:smoke step e against a protected Preview
VERCEL_AUTOMATION_BYPASS_SECRET=
# Expo push access token (server only)
EXPO_ACCESS_TOKEN=
# Months a deleted account's retained records are kept
DELETE_RETENTION_MONTHS=
# Translate requests allowed per day for all users together
TRANSLATE_GLOBAL_LIMIT_PER_DAY=
# Set to true to let a script run against the production database
ALLOW_PRODUCTION=
# Path of the seed users file (scripts only)
SEED_USERS_FILE=
